<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força HTTPS (evita o aviso "Não seguro" quando o acesso chega por http).
  # Cobre tanto SSL direto no Apache quanto SSL terminado num proxy à frente.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /.well-known/ nunca pode cair no catch-all do React Router abaixo.
  # O Android busca /.well-known/assetlinks.json esperando JSON para verificar
  # que este domínio autoriza o app (TWA); o ACME usa /.well-known/acme-challenge
  # para renovar o certificado. Sem esta exceção os dois recebiam o index.html
  # com content-type text/html e falhavam em silêncio — o app abriria com a
  # barra do navegador à mostra, em vez de tela cheia.
  RewriteRule ^\.well-known/ - [L]

  # Rotas do React Router: tudo que não for arquivo/pasta cai no index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ==========================================================================
# Cabeçalhos de segurança (SEG-03 e SEG-09 da auditoria de 03/09/2026).
# Até esta data o servidor não enviava NENHUM: sem CSP, sem frame-ancestors,
# sem Referrer-Policy, sem nosniff, sem HSTS. Com o token de sessão guardado
# no localStorage, qualquer XSS virava sequestro de conta.
#
# A CSP foi escrita contra o que o build realmente carrega (conferido em
# dist/index.html e nas telas):
#   script-src 'self'          o Vite não emite <script> inline neste projeto
#   style-src 'unsafe-inline'  o app usa style={{...}} do React em quase toda
#                              tela; tirar isso é refatoração grande, fica p/ depois
#   font-src 'self'            Lora e Inter self-hosted em src/fonts/
#   cdnjs.cloudflare.com       imagens dos marcadores do Leaflet em /app/mapa
#   *.tile.openstreetmap.org   ladrilhos do mapa
#   base44.app                 API onde ficam os dados
# ==========================================================================
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://cdnjs.cloudflare.com https://*.tile.openstreetmap.org; connect-src 'self' https://base44.app https://*.base44.app; media-src 'self' data: blob:; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"

  # Não vazar a rota visitada. Sem isto, o clique na "Saída rápida" — e qualquer
  # link externo aberto de /app/plano ou /app/diario — entrega o endereço de
  # origem para quem recebe a visita.
  Header always set Referrer-Policy "no-referrer"

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"

  # O app não usa câmera, microfone nem localização (conferido: não há
  # navigator.geolocation no código). Negar impede que script injetado peça.
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

  # Sem 'preload' de propósito: entrar na lista de preload dos navegadores é
  # difícil de desfazer e é decisão da Rede, não desta correção.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets com hash no nome
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# HostGator usa LiteSpeed, que cacheia o HTML por padrão e faz o deploy demorar
# a aparecer. Desliga o cache de página do LiteSpeed e marca o HTML como
# no-cache (os assets têm hash no nome, então podem ser cacheados forte).
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Só os arquivos de /assets/ têm hash no nome — esses podem ser imutáveis.
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # A verificação do Digital Asset Links exige application/json. Se o servidor
  # devolver text/plain o Android recusa em silêncio e o app abre com a barra
  # do navegador aparecendo. Também não pode ser cacheado por muito tempo: a
  # impressão digital da chave muda se a assinatura for reconfigurada.
  <FilesMatch "^assetlinks\.json$">
    ForceType application/json
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # sw.js e manifest.json NÃO têm hash. Estavam caindo na regra de 1 ano como
  # "immutable", o que congelava o service worker no navegador de quem já tinha
  # visitado o site: ele nunca era rebaixado, nunca reinstalava, e o cache dele
  # continuava servindo a versão antiga do app depois de cada deploy.
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
